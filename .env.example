# Transmutary 凭据模板 — 复制为 .env 填写（.env 不入库，见 .gitignore）。
# 凭据只从环境读取，不入库、不入镜像（R21/KTD4）。

# GitHub 只读 token（采集 release/issue/依赖）
TRANSMUTARY_GITHUB_TOKEN=

# LLM 配置默认走 dashboard 设置页 / `transmutary config`（写入 config/llm.yaml）。
# 下列 TRANSMUTARY_LLM_* 变量是 OPS 注入入口（systemd EnvironmentFile / docker
# secret），仅在「运行时不可被 UI 覆盖」时取消注释——env 始终胜过 yaml/UI，且设置后
# 该字段在 dashboard 中显示为只读锁定（见 README「凭据安全模型」）。普通自托管留空即可。
# TRANSMUTARY_LLM_API_KEY=
# TRANSMUTARY_LLM_BASE_URL=
# LiteLLM protocol: openai | anthropic | azure (prepended to bare model names)
# TRANSMUTARY_LLM_TRANSPORT=
# Per-tier model overrides (optional; defaults: gpt-4o / gpt-4o-mini / text-embedding-3-small)
# TRANSMUTARY_LLM_MODEL_STRONG=
# TRANSMUTARY_LLM_MODEL_CHEAP=
# TRANSMUTARY_LLM_MODEL_EMBED=
# Per-tier FULL override (optional) — run a tier on a DIFFERENT provider than the
# shared config above. Each field falls back to the shared value when unset.
# Common case: embeddings on a separate provider (chat provider has no embed API).
# Format: TRANSMUTARY_LLM_<TIER>_<FIELD>, TIER ∈ STRONG|CHEAP|EMBED,
#         FIELD ∈ API_KEY|BASE_URL|TRANSPORT|MODEL.
# TRANSMUTARY_LLM_EMBED_API_KEY=
# TRANSMUTARY_LLM_EMBED_BASE_URL=
# TRANSMUTARY_LLM_EMBED_TRANSPORT=openai
# TRANSMUTARY_LLM_EMBED_MODEL=
# (Leaving embed unconfigured is fine — the L2 grouping step degrades to full L3.)

# 邮件投递（SMTP）；RSS-only 部署可留空（仅 RSS 投递）
TRANSMUTARY_SMTP_USER=
TRANSMUTARY_SMTP_PASSWORD=

# 私有 RSS feed 鉴权 token
TRANSMUTARY_RSS_TOKEN=

# Dashboard admin 登录 token（只用于建立会话；provider secrets 仍只从 env 读取）
TRANSMUTARY_ADMIN_TOKEN=

# 可选：L3 日预算上限（USD/天），默认 5.0
# TRANSMUTARY_L3_DAILY_BUDGET_USD=5.0
